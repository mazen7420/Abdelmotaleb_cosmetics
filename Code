CREATE TABLE Warehouses (
    Warehouse_ID NUMBER PRIMARY KEY,
    Warehouse_Name VARCHAR2(50) NOT NULL UNIQUE,
    Warehouse_Phone VARCHAR2(20) NOT NULL UNIQUE,
    Branch_ID NUMBER NOT NULL,
    CONSTRAINT fk_warehouse_branch FOREIGN KEY (Branch_ID) REFERENCES Branches(Branch_ID)
);

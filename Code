CREATE TABLE Supply_Orders (
    Sorder_ID NUMBER PRIMARY KEY,
    Sorder_Date DATE NOT NULL,
    Payment_Method VARCHAR2(30) NOT NULL CHECK (Payment_Method IN ('Cash','Visa','Online')),
    Total_Price NUMBER NOT NULL CHECK (Total_Price >= 0),
    Branch_ID NUMBER NOT NULL,
    Supplier_ID NUMBER NOT NULL,
    CONSTRAINT fk_supply_branch FOREIGN KEY (Branch_ID) REFERENCES Branches(Branch_ID),
    CONSTRAINT fk_supply_supplier FOREIGN KEY (Supplier_ID) REFERENCES Suppliers(Supplier_ID)
);

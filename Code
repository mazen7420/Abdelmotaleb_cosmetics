CREATE TABLE Orders (
    Order_ID NUMBER PRIMARY KEY,
    Order_Date DATE NOT NULL,
    Payment_Method VARCHAR2(30) NOT NULL CHECK (Payment_Method IN ('Cash','Visa','Online')),
    Total_Price NUMBER NOT NULL CHECK (Total_Price > 0),
    Customer_ID NUMBER NOT NULL,
    Branch_ID NUMBER NOT NULL,
    CONSTRAINT fk_order_customer FOREIGN KEY (Customer_ID) REFERENCES Customers(Customer_ID),
    CONSTRAINT fk_order_branch FOREIGN KEY (Branch_ID) REFERENCES Branches(Branch_ID)
);

CREATE TABLE Products (
    Product_ID NUMBER PRIMARY KEY,
    Product_Name VARCHAR2(50) NOT NULL,
    Product_Category VARCHAR2(50) NOT NULL,
    Product_Brand VARCHAR2(50) NOT NULL,
    Price NUMBER NOT NULL CHECK (Price > 0),
    Stock_Quantity NUMBER NOT NULL CHECK (Stock_Quantity > 0),
    Expiry_Date DATE NOT NULL,
    Warehouse_ID NUMBER NOT NULL,
    CONSTRAINT fk_product_warehouse FOREIGN KEY (Warehouse_ID) REFERENCES Warehouses(Warehouse_ID)
);
